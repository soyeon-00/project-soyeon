/*회원가입 전체 로깆*/
document.addEventListener("DOMContentLoaded", () => {
    const emailInput = document.querySelector("input[name='email']");
    const passwordInput = document.querySelector("input[name='password']");
    const passwordConfirmInput = document.querySelector("input[name='passwordConfirm']");
    const nicknameInput = document.querySelector("input[name='nickname']");
    const phoneInput = document.querySelector("input[name='phone']");
    const addressInput = document.querySelector("#sample6_address");
    const registerButton = document.querySelector(".login-button");

    const emailResult = document.createElement("p");
    const passwordResult = document.createElement("p");
    const nicknameResult = document.createElement("p");
    const phoneResult = document.createElement("p");
    const addressResult = document.createElement("p");
    const agreeResults = document.createElement("p"); // 동의 결과 문구

    const existingEmails = ["test@example.com", "user@example.com"];
    const existingNicknames = ["nickname1", "nickname2"];

    const validateEmail = (email) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    const validatePassword = (password) => password.length >= 6;

    const checkEmail = (email) => existingEmails.includes(email);
    const checkNickname = (nickname) => existingNicknames.includes(nickname);

    registerButton.addEventListener("click", (event) => {
        event.preventDefault(); // 기본 동작 방지
        emailResult.innerText = "";
        passwordResult.innerText = "";
        nicknameResult.innerText = "";
        phoneResult.innerText = "";
        addressResult.innerText = "";
        agreeResults.innerText = ""; // 동의 결과 초기화

        // 이메일 검사
        if (!emailInput.value) {
            emailResult.innerText = "이메일을 입력하세요.";
            emailResult.style.color = "red";
            emailInput.parentNode.appendChild(emailResult);
            return;
        }

        if (!validateEmail(emailInput.value)) {
            emailResult.innerText = "유효한 이메일 형식이 아닙니다.";
            emailResult.style.color = "red";
            emailInput.parentNode.appendChild(emailResult);
            return;
        }

        // 이메일 중복 체크
        if (checkEmail(emailInput.value)) {
            emailResult.innerText = "이메일이 이미 사용 중입니다.";
            emailResult.style.color = "red";
            emailInput.parentNode.appendChild(emailResult);
            return;
        } else {
            emailResult.innerText = "사용 가능한 이메일입니다.";
            emailResult.style.color = "green";
            emailInput.parentNode.appendChild(emailResult);
        }

        // 비밀번호 검사
        if (!passwordInput.value) {
            passwordResult.innerText = "비밀번호를 입력하세요.";
            passwordResult.style.color = "red";
            passwordInput.parentNode.appendChild(passwordResult);
            return;
        }

        if (!validatePassword(passwordInput.value)) {
            passwordResult.innerText = "비밀번호는 최소 6자리여야 합니다.";
            passwordResult.style.color = "red";
            passwordInput.parentNode.appendChild(passwordResult);
            return;
        }

        // 비밀번호 확인 검사
        if (passwordInput.value !== passwordConfirmInput.value) {
            passwordResult.innerText = "비밀번호가 일치하지 않습니다.";
            passwordResult.style.color = "red";
            passwordConfirmInput.parentNode.appendChild(passwordResult);
            return;
        }

        // 닉네임 검사
        if (!nicknameInput.value) {
            nicknameResult.innerText = "닉네임을 입력하세요.";
            nicknameResult.style.color = "red";
            nicknameInput.parentNode.appendChild(nicknameResult);
            return;
        }

        // 닉네임 중복 체크
        if (checkNickname(nicknameInput.value)) {
            nicknameResult.innerText = "닉네임이 이미 사용 중입니다.";
            nicknameResult.style.color = "red";
            nicknameInput.parentNode.appendChild(nicknameResult);
            return;
        } else {
            nicknameResult.innerText = "사용 가능한 닉네임입니다.";
            nicknameResult.style.color = "green";
            nicknameInput.parentNode.appendChild(nicknameResult);
        }

        // 전화번호 검사
        if (!phoneInput.value) {
            phoneResult.innerText = "휴대폰 번호를 입력하세요.";
            phoneResult.style.color = "red";
            phoneInput.parentNode.appendChild(phoneResult);
            return;
        }

        if (phoneInput.value.length !== 11) {
            phoneResult.innerText = "휴대폰 번호는 11자리여야 합니다.";
            phoneResult.style.color = "red";
            phoneInput.parentNode.appendChild(phoneResult);
            return;
        }

        // 주소 검사
        if (!addressInput.value) {
            addressResult.innerText = "주소를 입력하세요.";
            addressResult.style.color = "red";
            addressInput.parentNode.appendChild(addressResult);
            return;
        }

        // 동의 체크
        const allAgree = document.querySelector(".allagree");
        const agree1 = document.querySelector("input[name='agree1']");
        const agree2 = document.querySelector("input[name='agree2']");
        const agree3 = document.querySelector("input[name='agree3']");
        const agree4 = document.querySelector("input[name='agree4']");

        if (!allAgree.checked || !agree1.checked || !agree2.checked || !agree3.checked || !agree4.checked) {
            agreeResults.innerText = "모든 약관에 동의해야 회원가입이 가능합니다.";
            agreeResults.style.color = "red";
            document.querySelector(".agree-box").appendChild(agreeResults);
            return;
        }

        // 모든 검증이 통과하면 완료 페이지로 이동
        alert("회원가입이 완료되었습니다!");
        window.location.href = "http://localhost:9000/powpow/buyer-join-complete.jsp"; // 완료 페이지로 이동
    });
});