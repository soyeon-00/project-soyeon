// 인증번호 유효성 체크 함수
function isValidAuthNumber(authNumber) {
    // 여기에 인증번호 유효성 검사 로직을 작성
    // 예를 들어, 숫자 6자리인지 체크
    return /^\d{6}$/.test(authNumber);
}