	/*핸드폰 번호*/
	document.addEventListener("DOMContentLoaded", () => {
	  const authButton = document.querySelector(".auth-button"); // 인증 요청 버튼
	  const authNumberContainer = document.getElementById("authNumberContainer"); // 인증번호 입력란
	  const confirmButton = document.querySelector(".confirm-button"); // 확인 버튼
	  const authNumberInput = document.querySelector("input[name='authNumber']"); // 인증번호 입력란
	  const passwordResult = document.getElementById("password-result"); // 안내 문구

	  // 인증 요청 버튼 클릭 시 인증번호 입력란 보여주기
	  authButton.addEventListener("click", () => {
	    authNumberContainer.style.display = "block"; // 인증번호 입력란 표시
	    passwordResult.innerText = ""; // 안내 문구 초기화
	  });

	  // 확인 버튼 클릭 시 유효성 검사
	  confirmButton.addEventListener("click", (event) => {
	    event.preventDefault(); // 기본 행동 방지

	    if (!authNumberInput.value) {
	      passwordResult.innerText = "인증번호를 입력하세요."; // 안내 문구
	      passwordResult.style.color = "red"; // 글자색 빨간색
	    } else if (authNumberInput.value.length !== 6) {
	      passwordResult.innerText = "인증번호가 올바르지 않습니다."; // 잘못된 인증번호 안내
	      passwordResult.style.color = "red"; // 글자색 빨간색
	    } else if (!/^\d{6}$/.test(authNumberInput.value)) {
	      passwordResult.innerText = "인증번호는 6자리 숫자여야 합니다."; // 숫자 형식 안내
	      passwordResult.style.color = "red"; // 글자색 빨간색
	    } else {
	      passwordResult.innerText = "올바른 인증번호를 입력하였습니다!"; // 올바른 경우
	      passwordResult.style.color = "green"; // 글자색 초록색
	    }
	  });
	});
	
